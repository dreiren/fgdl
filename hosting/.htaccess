Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# Legacy practice-area and Insights URLs.
RewriteRule ^practice-areas/corporate-labor/?$ /practice-areas/labor-employment/ [R=301,L]
RewriteRule ^practice-areas/litigation-criminal/?$ /practice-areas/military-administrative/ [R=301,L]
RewriteRule ^practice-areas/national-security/?$ /practice-areas/military-administrative/ [R=301,L]
RewriteRule ^practice-areas/general-counsel/?$ /practice-areas/human-resources-advisory/ [R=301,L]
RewriteRule ^insights(/.*)?$ / [R=301,L]

# Map /contact to /contact/index.html when the export used trailing slashes.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/ [R=301,L]
